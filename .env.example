# --- Database ---
POSTGRES_USER=drinkbot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=drinkbot
# Used by the backend (host is the compose service name)
DATABASE_URL=postgresql+asyncpg://drinkbot:change-me@postgres:5432/drinkbot

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# --- LLM ---
# Provider: ollama (local, free) | openai | gemini
LLM_PROVIDER=ollama
# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1
# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- API ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional: if set, menu admin endpoints require the X-Admin-Key header
ADMIN_API_KEY=
