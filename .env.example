# --- Database ---
POSTGRES_USER=drinkbot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=drinkbot
# Used by the backend (host is the compose service name)
DATABASE_URL=postgresql+asyncpg://drinkbot:change-me@postgres:5432/drinkbot

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# --- LLM ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_BASE_URL=

# --- API ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional: if set, menu admin endpoints require the X-Admin-Key header
ADMIN_API_KEY=
